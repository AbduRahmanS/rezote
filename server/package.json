{
  "name": "@rezote/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rezote sync server: stores encrypted events (Hono on Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rezote --local",
    "db:migrate:remote": "wrangler d1 migrations apply rezote --remote",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "wrangler": "^4.162.0"
  }
}
