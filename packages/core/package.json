{
  "name": "@rezote/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rezote skeleton: offline-first storage, encrypted sync, status, and React UI shell",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./node": "./src/node.ts",
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    },
    "./worker": "./src/worker.ts",
    "./security": {
      "types": "./security.d.mts",
      "default": "./security.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/store": "^0.11.2",
    "idb": "^8.0.4",
    "zod": "^4.6.7",
    "@rezote/ui": "*",
    "lucide-react": "^1.73.0",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.0"
  }
}
