{
  "name": "rezote-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev:collecte": "npm run dev -w @rezote/collecte",
    "dev:route": "npm run dev -w @rezote/carnet-de-route",
    "dev:server": "npm run dev -w @rezote/server",
    "build": "npm run build -w @rezote/collecte && npm run build -w @rezote/carnet-de-route",
    "check:size": "node scripts/check-size.mjs apps/collecte/dist apps/carnet-de-route/dist",
    "typecheck": "tsc -p packages/core && tsc -p server && tsc -p apps/collecte && tsc -p apps/carnet-de-route && tsc -p scripts",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "test": "vitest --run",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
