{
  "name": "rezote-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:collecte": "npm run dev -w @rezote/collecte",
    "dev:route": "npm run dev -w @rezote/carnet-de-route",
    "build": "npm run build -w @rezote/collecte && npm run build -w @rezote/carnet-de-route",
    "check:size": "node scripts/check-size.mjs apps/collecte/dist/client apps/carnet-de-route/dist/client",
    "typecheck": "tsc -p packages/ui && tsc -p packages/core && tsc -p packages/sync-api && tsc -p apps/collecte && tsc -p apps/carnet-de-route && tsc -p scripts",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "test": "vitest --run",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
