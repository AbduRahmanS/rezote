// Carnet de route: one Cloudflare Worker serves the app (TanStack Start, SPA mode) and the sync API under /api.
// See docs/deploy.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rezote-carnet",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // Served only on the custom domain. A single origin matters: data is stored per origin on the phone.
  "workers_dev": false,
  "routes": [{ "pattern": "carnet.abdrahamane.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rezote",
      // Shared by both apps (created with `npx wrangler d1 create rezote --location weur`).
      "database_id": "065a45d9-9bf8-42c8-bf31-411ce1ab6178",
      "migrations_dir": "../../packages/sync-api/migrations"
    }
  ],
  // 60 writes per minute per IP, per Cloudflare location.
  "ratelimits": [{ "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
