{
  "name": "@rezote/collecte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collecte: cooperative cotton weighing and farmer payments, offline-first",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node ../../scripts/build-sw.mjs dist/client",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rezote --local",
    "db:migrate:remote": "wrangler d1 migrations apply rezote --remote",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@rezote/core": "*",
    "@rezote/sync-api": "*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-store": "^0.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "@rezote/ui": "*",
    "lucide-react": "^1.73.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
